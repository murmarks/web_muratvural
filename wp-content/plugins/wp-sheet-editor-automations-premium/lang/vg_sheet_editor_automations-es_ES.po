#. Plugin Name of the plugin
msgid "WP Sheet Editor - Automations"
msgstr "WP Sheet Editor - Automations"

#. Plugin URI of the plugin
msgid ""
"https://wpsheeteditor.com/?utm_source=wp-admin&utm_medium=plugins-"
"list&utm_campaign=automations"
msgstr ""

#. Description of the plugin
msgid ""
"Automate tasks in the spreadsheet app to make you more productive. Schedule "
"exports, imports, bulk edits/formulas/php functions, manual edits in the "
"cells, and more. Run tasks once or recurringly. This is an extension and not "
"a standalone plugin."
msgstr ""
"Mejora tu productividad automatizando tareas en la aplicación de hojas de "
"cálculo. Programa exportaciones, importaciones, cambios masivos/fórmulas/"
"funciones php, ediciones manuales en las celdas y mucho más. Ejecuta tareas "
"una vez o de forma recurrente. Esta es una extensión y no un plugin "
"independiente."

