# Hostinger sunucusu için önbellek ve sıkıştırma kuralları.
# Bunlar olmadan tarayıcı her sayfa geçişinde (dil değiştirmek dahil) CSS, JavaScript ve yazı tipi
# dosyalarının değişip değişmediğini sunucuya tek tek sorar; uzak bağlantıda her soru bekleme demektir.
#
# - Sayfalar (HTML): her seferinde kısaca kontrol edilir; yeni yayın hemen görünür.
# - /_astro/ altındaki CSS, JavaScript ve yazı tipleri: adlarında içerik özeti var, değişince adları da değişir.
#   Bu yüzden bir yıl boyunca sormadan kullanılabilir.
# - Fotoğraflar: adreslerinde ?v= ile içerik özeti var (src/data/photos.ts); değişen fotoğraf yine hemen görünür.

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Arka plan ayar dosyası (ayarlar.txt): elle değiştirilince hemen görünsün, hiçbir yerde önbelleğe alınmasın.
<Files "ayarlar.txt">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-store, max-age=0"
  </IfModule>
</Files>
