---
/** Bütün hizmetler: dört alan, her biri giriş metni, bütün sayfalarının listesi ve fotoğraflarıyla. */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Gallery from '../../../components/Gallery.astro';
import { locales, useT, type Locale } from '../../../i18n';
import { countPages, flattenServices, serviceHref, services } from '../../../data/services';
import { areaIntro, areaPhotos } from '../../../data/home';
import { inline } from '../../../lib/inline';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<BaseLayout lang={lang} title={t('services')}>
  <div class="idx wrap">
    <header class="top">
      <p class="mono crumb"><a href={`/${lang}/`}>{t('home')}</a> / <span>{t('services')}</span></p>
      <h1 class="h2" set:html={t('svcTitle')} />
      <p class="lede">{t('svcIndexLede')}</p>
    </header>
    {
      services.map((a) => {
        const pages = flattenServices(a.children ?? [], [a]);
        return (
          <section class="ar" aria-labelledby={`h-${a.wp}`}>
            <div class="txt">
              <p class="n mono">0{a.no} · {countPages(a)} {t('pages')}</p>
              <h2 id={`h-${a.wp}`}>
                <a href={serviceHref(lang, a.slug)}>{a.title[lang]}</a>
              </h2>
              <p class="intro" set:html={inline(areaIntro[a.wp][lang])} />
              <ul>
                {pages.map((s) => (
                  <li style={`--d:${s.trail.length - 2}`}>
                    <a href={serviceHref(lang, s.path)}>
                      <b>{s.no}</b>
                      <span>{s.title[lang]}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <Gallery photos={areaPhotos[a.wp]} caption={false} />
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .idx {
    padding-block: calc(var(--bar-h) + 3rem + env(safe-area-inset-top, 0px)) 5rem;
  }
  .top {
    display: grid;
    gap: 1.4rem;
    padding-bottom: 3rem;
  }
  .crumb {
    margin: 0;
    color: var(--muted);
    text-transform: none;
  }
  .crumb a {
    text-decoration: none;
  }
  .crumb span {
    color: var(--amber);
  }
  .ar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
    gap: 2rem clamp(2rem, 5vw, 5rem);
    padding-block: 3rem;
    border-top: 1px solid var(--line);
    align-items: start;
  }
  .txt {
    display: grid;
    gap: 1.1rem;
    min-width: 0;
  }
  .n {
    margin: 0;
    color: var(--amber);
  }
  h2 {
    margin: 0;
    font: 800 clamp(1.8rem, 4vw, 3.6rem) / 0.95 var(--display);
    font-stretch: 112%;
    text-transform: uppercase;
    text-wrap: balance;
  }
  h2 a {
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--amber);
  }
  .intro {
    margin: 0;
    color: var(--muted);
    max-width: 58ch;
    font-size: 1.05rem;
  }
  .intro :global(b) {
    color: var(--fg);
    font-weight: 600;
  }
  ul {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    columns: 2 18rem;
    column-gap: 2.4rem;
  }
  li {
    break-inside: avoid;
    border-top: 1px solid var(--line);
    padding-left: calc(var(--d) * 1.2rem);
  }
  li a {
    display: grid;
    grid-template-columns: 3.8rem minmax(0, 1fr);
    padding: 0.5rem 0;
    text-decoration: none;
    font-size: 0.94rem;
    line-height: 1.35;
  }
  li a:hover span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  li b {
    font: 500 0.72rem/1.9 var(--mono);
    color: var(--amber);
  }
  @media (max-width: 860px) {
    .ar {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
