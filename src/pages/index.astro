---
/**
 * Kök adres (/): ziyaretçiyi kendi diline gönderir.
 * Sıra: 1) ziyaretçinin daha önce seçtiği dil, 2) ayar panelindeki ilk açılış dili (otomatik, Türkçe ya da İngilizce),
 * 3) varsayılan dil. Yönlendirme anında görünen sayfa sitenin temasıyla aynı renkte (parlama olmasın).
 * JavaScript yoksa iki dilin bağlantısı görünür.
 */
import { locales, site, theme, themeColor, themeColors } from '../config/site';
import AyarHead from '../components/AyarHead.astro';
import { localeNames, useT } from '../i18n';

const t = useT(site.defaultLocale);
---

<!doctype html>
<html lang={site.defaultLocale} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.brand === 'pebuc' ? 'PeBuC' : t('siteName')}</title>
    <meta name="description" content={t('metaDescription')} />
    <meta name="theme-color" content={themeColor} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}/`, Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <AyarHead />
    <script is:inline define:vars={{ locales, def: site.defaultLocale, regional: site.regional }}>
      // ilk açılış dili panelde seçilir (window.mvAl: AyarHead): 'otomatik' bölgesel kurala bakar, 'tr'/'en' herkesi o dilde açar
      const git = (s) => {
        let l = def;
        const mod = window.mvAl(s, 'site', 'dil');
        if (locales.includes(mod)) l = mod;
        else {
          let tz = '';
          try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
          const langs = (navigator.languages || [navigator.language || '']).map((x) => String(x).slice(0, 2).toLowerCase());
          for (const [k, r] of Object.entries(regional)) {
            if (r.timeZones.includes(tz) || langs.some((x) => r.languages.includes(x))) { l = k; break; }
          }
        }
        location.replace('/' + l + '/' + location.hash);
      };
      let secilen = null;
      try { secilen = localStorage.getItem('site-lang'); } catch (e) {}
      // ziyaretçi dili kendisi değiştirdiyse her zaman onun seçimi
      if (locales.includes(secilen)) location.replace('/' + secilen + '/' + location.hash);
      else {
        // sunucudaki güncel ayar beklenir; gelmezse tarayıcıdaki son ayar, o da yoksa varsayılan
        let gitti = false;
        const bir = (s) => { if (!gitti) { gitti = true; git(s || window.mvAyarOnbellek); } };
        window.mvAyar.then(bir);
        setTimeout(() => bir(null), 1500);
      }
    </script>
    <style define:vars={{ dbg: themeColors.dark, lbg: themeColors.light }}>
      body { margin: 0; min-height: 100svh; display: grid; place-content: center; gap: 1rem; background: var(--dbg); color: #f3f0ea; font: 500 1.1rem/1.4 system-ui, sans-serif; text-align: center; }
      nav { display: flex; gap: 1rem; justify-content: center; }
      a { color: #f2a900; }
      html[data-theme='light'] body { background: var(--lbg); color: #16140f; }
      html[data-theme='light'] a { color: #8f5e00; }
    </style>
  </head>
  <body>
    <p>{t('chooseLanguage')}</p>
    <nav>{locales.map((l) => <a href={`/${l}/`} hreflang={l} lang={l}>{localeNames[l]}</a>)}</nav>
  </body>
</html>
