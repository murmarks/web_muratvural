---
/**
 * Kök adres (/): ziyaretçiyi kendi diline gönderir.
 * Sıra: 1) ziyaretçinin daha önce seçtiği dil, 2) site.ts'deki dil modu (sabit ya da bölgesel), 3) varsayılan dil.
 * JavaScript yoksa iki dilin bağlantısı görünür.
 */
import { locales, site, theme, themeColor } from '../config/site';
import { localeNames, useT } from '../i18n';

const t = useT(site.defaultLocale);
// yönlendirme anında görünen sayfa, sitenin temasıyla aynı renkte (beyaz/siyah parlama olmasın)
const c = theme === 'light' ? { fg: '#16140f', link: '#8f5e00' } : { fg: '#f3f0ea', link: '#f2a900' };
---

<!doctype html>
<html lang={site.defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.brand === 'pebuc' ? 'PeBuC' : t('siteName')}</title>
    <meta name="description" content={t('metaDescription')} />
    <meta name="theme-color" content={themeColor} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}/`, Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script
      is:inline
      define:vars={{ locales, def: site.defaultLocale, mode: site.languageMode, regional: site.regional }}
    >
      let l = null;
      try { l = localStorage.getItem('site-lang'); } catch (e) {}
      if (!locales.includes(l)) {
        l = def;
        if (mode === 'regional') {
          let tz = '';
          try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
          const langs = (navigator.languages || [navigator.language || '']).map((x) => String(x).slice(0, 2).toLowerCase());
          for (const [k, r] of Object.entries(regional)) {
            if (r.timeZones.includes(tz) || langs.some((x) => r.languages.includes(x))) { l = k; break; }
          }
        }
      }
      location.replace('/' + l + '/' + location.hash);
    </script>
    <style define:vars={{ bg: themeColor, fg: c.fg, link: c.link }}>
      body { margin: 0; min-height: 100svh; display: grid; place-content: center; gap: 1rem; background: var(--bg); color: var(--fg); font: 500 1.1rem/1.4 system-ui, sans-serif; text-align: center; }
      nav { display: flex; gap: 1rem; justify-content: center; }
      a { color: var(--link); }
    </style>
  </head>
  <body>
    <p>{t('chooseLanguage')}</p>
    <nav>{locales.map((l) => <a href={`/${l}/`} hreflang={l} lang={l}>{localeNames[l]}</a>)}</nav>
  </body>
</html>
