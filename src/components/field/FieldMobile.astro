---
/**
 * Telefonda seçeneklerin dikey hâli: her yer kendi fotoğraflarıyla, alt alta.
 * Görünüm seçeneğe göre değişir (variant): manşet yazısı, yatay şerit, rota çizgisi ya da baskı.
 */
import type { Locale } from '../../config/site';
import { dms, fieldPlaces, westToEast } from '../../data/field';
import Pin from '../Pin.astro';

interface Props {
  lang: Locale;
  variant: 'manset' | 'serit' | 'rota' | 'baski';
}
const { lang, variant } = Astro.props;
const list = variant === 'rota' ? westToEast : fieldPlaces;
let n = 0;
---

<div class:list={['fmob', `fmob-${variant}`]}>
  {
    list.map((pl) => (
      <article class="fmob-pl" data-fmob>
        <header class="fmob-h">
          <span class="fmob-ll mono">{dms(pl.ll, lang)}</span>
          <h3 class="fmob-c">
            <Pin />
            <span>{pl.country[lang]}</span>
          </h3>
          <p class="fmob-city" lang={pl.cityLang}>
            {pl.city[lang]}
          </p>
        </header>
        <div class="fmob-ps">
          {pl.photos.map((p) => (
            <div class="fmob-p" style={`--ar:${(p.w / p.h).toFixed(4)};--nw:${p.w}px;--r:${[-1.8, 1.4, -0.9, 2][n++ % 4]}deg`}>
              <img src={p.src} alt={`${pl.country[lang]}, ${pl.city[lang]}: ${pl.what[lang]}`} width={p.w} height={p.h} loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
        <p class="fmob-what">{pl.what[lang]}</p>
      </article>
    ))
  }
</div>

<style is:global>
  .fmob {
    display: none;
  }
  @media (max-width: 860px) {
    .fmob {
      display: grid;
      gap: 3.5rem;
      padding: 1.5rem var(--gr) 4rem var(--gl);
    }
    .fmob-h {
      display: grid;
      gap: 0.3rem;
      margin-bottom: 1rem;
    }
    .fmob-ll {
      font-size: 0.62rem;
      letter-spacing: 0.12em;
      color: var(--dim);
    }
    .fmob-c {
      margin: 0;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font: 800 1.5rem/1 var(--display);
      font-stretch: 112%;
      text-transform: uppercase;
    }
    .fmob-c .pin {
      color: var(--amber);
    }
    .fmob-c .pin svg {
      width: 0.85rem;
      height: 1.05rem;
      display: block;
    }
    .fmob-city {
      margin: 0;
      font: 500 0.72rem/1.3 var(--mono);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .fmob-ps {
      display: grid;
      gap: 12px;
    }
    .fmob-p {
      width: min(100%, var(--nw));
      aspect-ratio: var(--ar);
    }
    .fmob-p img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      box-shadow: 0 30px 60px -30px #000, 0 0 0 1px rgba(243, 240, 234, 0.1);
    }
    .fmob-what {
      margin: 0.9rem 0 0;
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.45;
    }

    /* manşet: büyük ülke adı, şehir çizgi harfle */
    .fmob-manset .fmob-c {
      font-size: clamp(2.2rem, 11vw, 3.4rem);
      line-height: 0.92;
    }
    .fmob-manset .fmob-c .pin {
      display: none;
    }
    .fmob-manset .fmob-city {
      font: 800 1.3rem/1 var(--display);
      font-stretch: 112%;
      color: transparent;
      -webkit-text-stroke: 1px rgba(243, 240, 234, 0.55);
      letter-spacing: 0;
    }
    .fmob-manset .fmob-ll {
      color: var(--amber);
      order: -1;
    }
    .fmob-manset .fmob-what {
      border-top: 1px solid var(--line);
      padding-top: 0.8rem;
    }

    /* şerit: yerin fotoğrafları yana kayar */
    .fmob-serit .fmob-ps {
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(-1 * var(--gl)) calc(-1 * var(--gr));
      padding-inline: var(--gl) var(--gr);
      scrollbar-width: none;
    }
    .fmob-serit .fmob-p {
      height: min(56vw, 300px);
      width: auto;
      scroll-snap-align: center;
    }
    .fmob-serit .fmob-h {
      border-bottom: 1px solid var(--line);
      padding-bottom: 0.7rem;
    }

    /* rota: soldaki sarı çizgi yerleri birbirine bağlar */
    .fmob-rota {
      gap: 0;
    }
    .fmob-rota .fmob-pl {
      position: relative;
      padding: 0 0 3.2rem 1.8rem;
      border-left: 1px solid rgba(242, 169, 0, 0.45);
      margin-left: 0.45rem;
    }
    .fmob-rota .fmob-pl:last-child {
      border-left-color: transparent;
    }
    .fmob-rota .fmob-c .pin {
      display: none;
    }
    .fmob-rota .fmob-pl::before {
      /* yolun üstündeki durak */
      content: '';
      position: absolute;
      left: -5px;
      top: 1.55rem;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--amber);
      box-shadow: 0 0 0 4px var(--bg);
    }

    /* baskı: kâğıt kenarlı, hafif açılı */
    .fmob-baski .fmob-ps {
      gap: 22px;
      padding: 0.4rem 0.6rem;
    }
    .fmob-baski .fmob-p {
      box-sizing: content-box;
      width: min(calc(100% - 20px), var(--nw));
      padding: 10px;
      background: #e9e3d6;
      transform: rotate(var(--r));
      box-shadow: 0 1px 1px rgba(0, 0, 0, 0.5), 0 30px 50px -24px #000;
    }
    .fmob-baski .fmob-p img {
      box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25);
    }
  }
</style>
