---
/**
 * Sol paneldeki hizmet haritası. Eski sitedeki akordiyon menünün karşılığı:
 * bulunulan sayfanın tüm üst dalları açık gelir, sayfanın kendisi işaretlenir.
 * JavaScript olmadan çalışır (<details>/<summary>).
 */
import type { Service } from '../data/services';
import { serviceHref } from '../data/services';

interface Props {
  nodes: Service[];
  /** Bulunulan sayfanın tam yolu, ör. "performance-enhancement/team-performance/coaching" */
  current?: string;
  /** İç kullanım: üst düğümlerin yolu */
  base?: string;
  depth?: number;
}

const { nodes, current = '', base = '', depth = 0 } = Astro.props;
---

<ul class="service-nav" data-depth={depth}>
  {
    nodes.map((node) => {
      const path = base ? `${base}/${node.slug}` : node.slug;
      const isCurrent = path === current;
      const isOpen = current === path || current.startsWith(`${path}/`);
      const link = (
        <a href={serviceHref(path)} aria-current={isCurrent ? 'page' : undefined}>
          <span class="no">{node.no}</span>
          <span class="title">{node.title}</span>
        </a>
      );
      return (
        <li>
          {node.children ? (
            <details open={isOpen}>
              <summary>{link}</summary>
              <Astro.self nodes={node.children} current={current} base={path} depth={depth + 1} />
            </details>
          ) : (
            link
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .service-nav {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .service-nav[data-depth]:not([data-depth='0']) {
    padding-inline-start: 0.9rem;
    border-inline-start: 1px solid var(--line, #ddd);
    margin-inline-start: 0.6rem;
  }
  summary {
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  a {
    display: flex;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
    border-radius: 0.4rem;
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    background: var(--hover, rgba(0, 0, 0, 0.05));
  }
  a[aria-current='page'] {
    background: var(--accent, #f5b400);
    color: var(--on-accent, #111);
    font-weight: 600;
  }
  .no {
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
    min-width: 3.2ch;
  }
</style>
